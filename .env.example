# The developer path needs no database and no account. Every setting is optional.

# Which embedder ranks related decisions: "deterministic" (default, offline) or "local"
# (needs the `embeddings` extra). A repo's .reasonledger/conflict.yml overrides this.
# RL_EMBEDDING_PROVIDER=deterministic

# Opt-in local usage metrics for a pilot; nothing is written unless this is 1.
# RL_METRICS=1
